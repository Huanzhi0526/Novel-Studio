{
  "name": "novel-studio",
  "version": "0.2.6",
  "private": true,
  "description": "个人小说写作工作台",
  "type": "module",
  "main": "app/main/index.mjs",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "start:kb-v2": "node scripts/kb-v2/start-v2.mjs",
    "setup:electron": "node scripts/setup-electron.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "package:windows": "node scripts/release.mjs",
    "package:source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "43.2.0",
    "esbuild": "0.27.3",
    "opencc-js": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  }
}
